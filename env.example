# Copie para .env.local (uso local) ou cadastre estas variáveis na Vercel
# (Project > Settings > Environment Variables). NUNCA faça commit de valores reais.

# ID da planilha (o trecho entre /d/ e /edit na URL do Google Sheets)
SHEET_ID=

# Aba e colunas lidas. Opcional; o padrão é Planilha1!A:K
SHEET_RANGE=Planilha1!A:K

# Conta de serviço do Google (veja o README, passo 2)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Cole a chave privada inteira. Pode ficar entre aspas, com \n no lugar das quebras de linha.
GOOGLE_PRIVATE_KEY=

# Senha de acesso à página. Muito recomendado: sem ela, qualquer pessoa com o link vê as comissões.
APP_PASSWORD=
